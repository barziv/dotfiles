# macOS
.DS_Store

# Local-only files containing secrets (generated by setup.py)
.secrets.env
.claude-managed-settings.json
zsh/secrets.zsh
nushell/secrets.nu

tmux/plugins/

opencode/node_modules/

# Python bytecode (setup.py)
__pycache__/
*.pyc

# Local-only skills (personal / momentum work — not for public repo)
claude/skills/glance/
claude/skills/validate-gap/

# Nushell runtime state (history + vendor autoloads)
nushell/history.txt
nushell/vendor/


# Claude Code account-skill sync cache (written through the ~/.claude/skills symlink)
claude/skills/synced/

# Local settings backups
*.bak
