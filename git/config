[user]
	email = barziv65@gmail.com
	name = barziv
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[http]
	postBuffer = 524288000

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

# Per-folder GitHub account. One includeIf per folder (trailing slash = whole tree).
# Keep below the global credential helpers so the profiles override them.
# The profile's credential username also picks the gh CLI account (see nushell/zsh hooks).
[includeIf "gitdir:~/Code/dotfiles/"]
	path = profiles/barziv.gitconfig
